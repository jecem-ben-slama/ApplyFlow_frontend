# ============================================================
# STAGE 1: Build Angular application
# ============================================================

FROM node:24.13.0-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

ARG BUILD_PROFILE=production

RUN npm run build -- --configuration=${BUILD_PROFILE}


# ============================================================
# STAGE 2: Serve Angular with Nginx
# ============================================================

FROM nginx:alpine

# Angular production build
COPY --from=build /app/dist/applyflow-ui /usr/share/nginx/html

# Custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Container startup script
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

# Vercel provides PORT.
# 80 is the default fallback.
ENV PORT=80

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]